<Window x:Class="OneFlowHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OneFlowHub.ViewModels"
        Title="1Flow HUB" Width="1220" Height="800" MinWidth="980" MinHeight="640"
        Icon="pack://application:,,,/assets/app.ico"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UI}" Foreground="{StaticResource Text}" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="-1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="T1" Storyboard.TargetProperty="X" From="0" To="260" Duration="0:0:19">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="T1" Storyboard.TargetProperty="Y" From="0" To="180" Duration="0:0:23">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="T2" Storyboard.TargetProperty="X" From="0" To="-300" Duration="0:0:25">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="T2" Storyboard.TargetProperty="Y" From="0" To="200" Duration="0:0:21">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="T3" Storyboard.TargetProperty="X" From="0" To="240" Duration="0:0:27">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="T3" Storyboard.TargetProperty="Y" From="0" To="-160" Duration="0:0:24">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="Root">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F00A0D2A" Offset="0"/>
                <GradientStop Color="#F4070816" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- slow aurora -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="820" Height="820" Canvas.Left="-260" Canvas.Top="-320">
                <Ellipse.Fill>
                    <RadialGradientBrush><GradientStop Color="#704F6BFF" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform x:Name="T1"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="760" Height="760" Canvas.Right="-240" Canvas.Top="60">
                <Ellipse.Fill>
                    <RadialGradientBrush><GradientStop Color="#5022D3EE" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform x:Name="T2"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="700" Height="700" Canvas.Left="320" Canvas.Bottom="-380">
                <Ellipse.Fill>
                    <RadialGradientBrush><GradientStop Color="#50EC4899" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform x:Name="T3"/></Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ───────── sidebar ───────── -->
            <Border Grid.Column="0" Background="#0AFFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid Margin="20,22,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="6,0,0,32">
                        <Border Width="40" Height="40" CornerRadius="13" Background="{StaticResource AccentGradient}">
                            <TextBlock Text="1" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="1Flow" FontSize="20" FontWeight="SemiBold" LineHeight="22"/>
                            <TextBlock Text="HUB" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,-1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" WindowChrome.IsHitTestVisibleInChrome="True">
                        <RadioButton Style="{StaticResource Nav}" Tag="&#xE71D;" Content="აპლიკაციები" IsChecked="True"
                                     Command="{Binding PageCommand}" CommandParameter="0"/>
                        <RadioButton Style="{StaticResource Nav}" Tag="&#xE81C;" Content="განახლებები"
                                     Command="{Binding PageCommand}" CommandParameter="1"/>
                        <RadioButton Style="{StaticResource Nav}" Tag="&#xE713;" Content="პარამეტრები"
                                     Command="{Binding PageCommand}" CommandParameter="2"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Border Visibility="{Binding HasHubUpdate, Converter={StaticResource B2V}}" Margin="0,0,0,14" Padding="14"
                                CornerRadius="16" Background="#1F5CE6A0" BorderBrush="#555CE6A0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding HubUpdateText}" FontSize="13" FontWeight="SemiBold" Foreground="#A7F3D0"/>
                                <TextBlock Text="HUB-ს ახალი ვერსია აქვს" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,10"/>
                                <ProgressBar Style="{StaticResource Flow}" Value="{Binding HubProgress, Mode=OneWay}" Maximum="100" Margin="0,0,0,10"
                                             Visibility="{Binding HubBusy, Converter={StaticResource B2V}}"/>
                                <Button Style="{StaticResource Pill}" Content="განახლება" Padding="10,8" FontSize="13"
                                        Background="#5CE6A0" Command="{Binding HubUpdateCommand}"
                                        WindowChrome.IsHitTestVisibleInChrome="True"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource Muted}">
                            <Run Text="1Flow HUB "/><Run Text="{Binding HubVersion, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ───────── content ───────── -->
            <Grid Grid.Column="1" Margin="44,0,40,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ═════ apps page ═════ -->
                <Grid Grid.Row="1" x:Name="PageApps" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Page}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard><Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="18" To="0" Duration="0:0:0.5">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard></BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,4,0,26">
                        <StackPanel>
                            <TextBlock Text="აპლიკაციები" FontSize="36" FontWeight="Light"/>
                            <TextBlock Text="{Binding Summary}" FontSize="14" Foreground="{StaticResource Muted}" Margin="2,4,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource IconBtn}" Content="&#xE72C;" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding RefreshCommand}" ToolTip="განახლება"
                                WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,8,0,0"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Apps}" Margin="0,0,0,24" VerticalAlignment="Top">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AppVM}">
                                    <Border x:Name="Card" Margin="0,0,20,20" Padding="22" CornerRadius="24"
                                            Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                            RenderTransformOrigin="0.5,0.5" Cursor="Hand">
                                        <Border.RenderTransform><ScaleTransform x:Name="Sc"/></Border.RenderTransform>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}"/>
                                        </Border.InputBindings>
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard><Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6"/>
                                                </Storyboard></BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="UIElement.MouseEnter">
                                                <BeginStoryboard><Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#66FFFFFF" Duration="0:0:0.25"/>
                                                </Storyboard></BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="UIElement.MouseLeave">
                                                <BeginStoryboard><Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3"/>
                                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3"/>
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#26FFFFFF" Duration="0:0:0.3"/>
                                                </Storyboard></BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="76"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="54" Height="54" CornerRadius="17">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="{Binding AccentFrom}" Offset="0"/>
                                                            <GradientStop Color="{Binding AccentTo}" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Grid>
                                                        <TextBlock Text="{Binding Glyph}" FontSize="24" FontWeight="SemiBold" Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding ShowGlyph, Converter={StaticResource B2V}}"/>
                                                        <Image Source="{Binding Icon}" Margin="9" RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="{Binding HasIcon, Converter={StaticResource B2V}}"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding VersionText}" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Grid.Row="1" Text="{Binding Description}" Margin="0,16,0,0" FontSize="13.5" LineHeight="20"
                                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>

                                            <StackPanel Grid.Row="2" Margin="0,10,0,12">
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource Muted}"/>
                                                <ProgressBar Style="{StaticResource Flow}" Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,8,0,0"
                                                             Visibility="{Binding IsBusy, Converter={StaticResource B2V}}"/>
                                            </StackPanel>

                                            <Button Grid.Row="3" Style="{StaticResource Pill}" Content="{Binding PrimaryText}"
                                                    Background="{Binding PrimaryBrush}" Foreground="{Binding PrimaryForeground}"
                                                    Command="{Binding PrimaryCommand}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ═════ updates page ═════ -->
                <Grid Grid.Row="1" x:Name="PageUpdates" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Page}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard><Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="18" To="0" Duration="0:0:0.5">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard></BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,4,0,26">
                        <TextBlock Text="განახლებები" FontSize="36" FontWeight="Light"/>
                        <TextBlock Text="ბოლო ცვლილებები ყველა პროგრამაში" FontSize="14" Foreground="{StaticResource Muted}" Margin="2,4,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Text="განახლებების ისტორია ჯერ არ ჩანს. შეამოწმე ინტერნეტი და დააჭირე განახლებას."
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFeed}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Feed}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FeedItem}">
                                        <Border Margin="0,0,0,14" Padding="22,20" CornerRadius="22" Background="{StaticResource Surface}"
                                                BorderBrush="{StaticResource Line}" BorderThickness="1" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="46" Height="46" CornerRadius="15" VerticalAlignment="Top">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="{Binding AccentFrom}" Offset="0"/>
                                                            <GradientStop Color="{Binding AccentTo}" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <TextBlock Text="{Binding Glyph}" FontSize="20" FontWeight="SemiBold" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding AppName}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <Border Margin="10,0,0,0" Padding="9,2" CornerRadius="10" Background="#26FFFFFF" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Tag}" FontSize="12"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DateText}" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,3,0,10"/>
                                                    <ItemsControl ItemsSource="{Binding Lines}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,7">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Ellipse Width="5" Height="5" Fill="{StaticResource Accent}" Margin="0,8,10,0" VerticalAlignment="Top"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13.5" LineHeight="20"
                                                                               Foreground="#DCDFF5" TextTrimming="CharacterEllipsis" MaxHeight="40"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ═════ settings page ═════ -->
                <Grid Grid.Row="1" x:Name="PageSettings" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Page}" Value="2">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard><Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="18" To="0" Duration="0:0:0.5">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard></BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="0,4,0,0">
                        <TextBlock Text="პარამეტრები" FontSize="36" FontWeight="Light" Margin="0,0,0,26"/>

                        <Border Padding="22,18" CornerRadius="20" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,0,12">
                            <Grid>
                                <StackPanel Margin="0,0,70,0">
                                    <TextBlock Text="დახურვა tray-ში" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="X-ზე დაჭერისას HUB არ გაითიშება და tray-ში დარჩება" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CloseToTray, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Padding="22,18" CornerRadius="20" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,0,12">
                            <Grid>
                                <StackPanel Margin="0,0,70,0">
                                    <TextBlock Text="გაშვება Windows-თან ერთად" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="HUB ჩაირთვება კომპიუტერის ჩართვისას, ფანჯრის გარეშე" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Padding="22,18" CornerRadius="20" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,0,12">
                            <Grid>
                                <StackPanel Margin="0,0,70,0">
                                    <TextBlock Text="განახლებების შემოწმება გაშვებისას" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="HUB-ისა და პროგრამების ახალი ვერსიები ავტომატურად მოიძებნება" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CheckOnStart, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Padding="22,18" CornerRadius="20" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,0,12">
                            <Grid>
                                <StackPanel Margin="0,0,150,0">
                                    <TextBlock Text="პროგრამების საქაღალდე" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DataFolder}" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Style="{StaticResource Ghost}" Content="გახსნა" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Command="{Binding OpenDataFolderCommand}"/>
                            </Grid>
                        </Border>
                        <Border Padding="22,18" CornerRadius="20" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <Grid>
                                <StackPanel Margin="0,0,200,0">
                                    <TextBlock Text="1Flow HUB" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding HubVersion}" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Style="{StaticResource Ghost}" Content="შემოწმება" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Command="{Binding CheckHubCommand}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ───────── window buttons ───────── -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource WinBtn}" Content="&#xE921;" Click="OnMinimize"/>
                <Button Style="{StaticResource WinBtn}" Content="&#xE922;" Click="OnMaximize"/>
                <Button Style="{StaticResource CloseBtn}" Content="&#xE8BB;" Click="OnClose"/>
            </StackPanel>
        </Grid>

        <!-- ───────── details overlay ───────── -->
        <Grid x:Name="DetailsHost" Background="#B8050716" Visibility="Collapsed" MouseLeftButtonDown="OnOverlayDown">
            <Border x:Name="DetailsCard" Width="800" MaxHeight="660" Margin="40" Padding="30,28,30,26" CornerRadius="28"
                    VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                    BorderBrush="#33FFFFFF" BorderThickness="1" MouseLeftButtonDown="OnCardDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F21A1F54" Offset="0"/>
                        <GradientStop Color="#F70B0D28" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="DScale" ScaleX="0.96" ScaleY="0.96"/>
                        <TranslateTransform x:Name="DShift" Y="24"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Grid DataContext="{Binding Details}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="58" Height="58" CornerRadius="18">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{Binding AccentFrom}" Offset="0"/>
                                    <GradientStop Color="{Binding AccentTo}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <TextBlock Text="{Binding Glyph}" FontSize="26" FontWeight="SemiBold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding ShowGlyph, Converter={StaticResource B2V}}"/>
                                <Image Source="{Binding Icon}" Margin="10" Visibility="{Binding HasIcon, Converter={StaticResource B2V}}"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE8BB;" FontSize="12"
                                Click="OnDetailsClose" VerticalAlignment="Top"/>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="14" LineHeight="21" Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" Margin="0,18,0,16"/>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden" Margin="0,0,0,14">
                            <ItemsControl ItemsSource="{Binding Tabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ReleaseTab}">
                                        <Button Margin="0,0,8,0" Content="{Binding Tag}"
                                                Command="{Binding DataContext.SelectTabCommand, ElementName=Root}" CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                                                    <Setter Property="Padding" Value="14,7"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource Text}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedDate}" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
                                <ItemsControl ItemsSource="{Binding SelectedNotes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Text}" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0"
                                                           Foreground="{StaticResource Accent}" TextWrapping="Wrap"
                                                           Visibility="{Binding IsHeading, Converter={StaticResource B2V}}"/>
                                                <TextBlock Text="{Binding Text}" FontSize="14" LineHeight="22" Foreground="#DCDFF5" TextWrapping="Wrap"
                                                           Visibility="{Binding IsText, Converter={StaticResource B2V}}"/>
                                                <Grid Visibility="{Binding IsBullet, Converter={StaticResource B2V}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,8,12,0" VerticalAlignment="Top"/>
                                                    <Border Grid.Column="1" Visibility="{Binding HasTag, Converter={StaticResource B2V}}"
                                                            Margin="0,2,10,0" Padding="9,2" CornerRadius="9" Background="#26FFFFFF" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Tag}" FontSize="11.5"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="14" LineHeight="22"
                                                               Foreground="#DCDFF5" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Style="{StaticResource Pill}" Content="{Binding PrimaryText}" MinWidth="190"
                                Background="{Binding PrimaryBrush}" Foreground="{Binding PrimaryForeground}"
                                Command="{Binding PrimaryCommand}"/>
                        <Button Style="{StaticResource Ghost}" Content="საქაღალდე" Margin="10,0,0,0"
                                Command="{Binding LocateCommand}"/>
                        <Button Style="{StaticResource Ghost}" Content="{Binding RemoveText}" Margin="10,0,0,0"
                                Command="{Binding RemoveCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ───────── toast ───────── -->
        <Border x:Name="ToastBox" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,30" Padding="22,13"
                CornerRadius="16" Background="#F0161A44" BorderBrush="#40FFFFFF" BorderThickness="1" Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform><TranslateTransform x:Name="ToastShift" Y="20"/></Border.RenderTransform>
            <TextBlock Text="{Binding ToastText}" FontSize="14"/>
        </Border>
    </Grid>
</Window>
