<Window x:Class="OneFlowHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:OneFlowHub.Views"
        Title="1Flow HUB" Width="1240" Height="800" MinWidth="1000" MinHeight="640"
        Icon="pack://application:,,,/assets/app.ico"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UI}" FontSize="13" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="-1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="{StaticResource Bg}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═════════════ sidebar ═════════════ -->
            <Border Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid Margin="12,0,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Border Width="26" Height="26" CornerRadius="6" Background="{StaticResource Accent}">
                            <TextBlock Text="1" FontSize="15" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="1Flow HUB" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,10,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <RadioButton Style="{StaticResource Nav}" Tag="&#xE80F;" Content="მიმოხილვა" GroupName="nav"
                                     IsChecked="{Binding IsHome, Mode=OneWay}" Command="{Binding PageCommand}" CommandParameter="0"/>
                        <RadioButton Style="{StaticResource Nav}" Tag="&#xE71D;" Content="აპლიკაციები" GroupName="nav"
                                     IsChecked="{Binding IsLibrary, Mode=OneWay}" Command="{Binding PageCommand}" CommandParameter="1"/>
                        <Grid>
                            <RadioButton Style="{StaticResource Nav}" Tag="&#xE895;" Content="განახლებები" GroupName="nav"
                                         IsChecked="{Binding IsUpdates, Mode=OneWay}" Command="{Binding PageCommand}" CommandParameter="2"/>
                            <Border Visibility="{Binding HasUpdates, Converter={StaticResource B2V}}" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,-2,12,0" MinWidth="20" Height="18" CornerRadius="9"
                                    Background="{StaticResource Warn}" IsHitTestVisible="False">
                                <TextBlock Text="{Binding UpdateCount}" FontSize="11" FontWeight="Bold" Foreground="#1B1400"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0"/>
                            </Border>
                        </Grid>

                        <Border Height="1" Background="{StaticResource Line}" Margin="8,12,8,12"/>
                        <RadioButton Style="{StaticResource Nav}" Tag="&#xE713;" Content="პარამეტრები" GroupName="nav"
                                     IsChecked="{Binding IsSettings, Mode=OneWay}" Command="{Binding PageCommand}" CommandParameter="3"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Border Visibility="{Binding HasHubUpdate, Converter={StaticResource B2V}}" Margin="0,0,0,10" Padding="12"
                                Style="{StaticResource Panel}" BorderBrush="{StaticResource Accent}">
                            <StackPanel>
                                <TextBlock Text="{Binding HubUpdateText}" FontSize="12.5" FontWeight="SemiBold"/>
                                <TextBlock Text="ხელმისაწვდომია ახალი ვერსია" Style="{StaticResource Hint}" FontSize="11.5" Margin="0,2,0,8"/>
                                <ProgressBar Style="{StaticResource Flow}" Value="{Binding HubProgress, Mode=OneWay}" Maximum="100" Margin="0,0,0,8"
                                             Visibility="{Binding HubBusy, Converter={StaticResource B2V}}"/>
                                <Button Style="{StaticResource Pill}" Content="განახლება" Padding="10,6" FontSize="12.5"
                                        Command="{Binding HubUpdateCommand}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Margin="8,0,0,2" Style="{StaticResource Hint}" FontSize="11.5">
                            <Run Text="ვერსია "/><Run Text="{Binding HubVersion, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═════════════ main column ═════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <!-- top bar -->
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                    <Grid Margin="28,0,160,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1" Width="300" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBox Style="{StaticResource Search}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE894;" Width="26" Height="26" FontSize="9" HorizontalAlignment="Right"
                                    Margin="0,0,4,0" Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding HasSearch, Converter={StaticResource B2V}}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- pages -->
                <Grid Grid.Row="1" Margin="28,22,22,0">
                    <v:HomeView x:Name="HomePage" Visibility="Visible"/>
                    <v:LibraryView x:Name="LibraryPage" Visibility="Collapsed"/>
                    <v:UpdatesView x:Name="UpdatesPage" Visibility="Collapsed"/>
                    <v:SettingsView x:Name="SettingsPage" Visibility="Collapsed"/>
                </Grid>

                <!-- status bar -->
                <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="{StaticResource Side}">
                    <Grid Margin="28,0,22,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Ok}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                <Setter Property="Fill" Value="{StaticResource Danger}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Hint}" FontSize="11.5"/>
                            <TextBlock Text="{Binding SyncText}" Style="{StaticResource Hint}" FontSize="11.5" Margin="16,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Hint}" FontSize="11.5"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- window buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WinBtn}" Content="&#xE921;" Click="OnMinimize"/>
                    <Button Style="{StaticResource WinBtn}" Content="&#xE922;" Click="OnMaximize"/>
                    <Button Style="{StaticResource CloseBtn}" Content="&#xE8BB;" Click="OnClose"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ═════════════ details drawer ═════════════ -->
        <Grid x:Name="DrawerHost" Visibility="Collapsed" Background="#99000000" MouseLeftButtonDown="OnScrimDown">
            <Border x:Name="DrawerPanel" Width="480" HorizontalAlignment="Right" MouseLeftButtonDown="OnPanelDown"
                    Background="#1A1A1D" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <Border.RenderTransform><TranslateTransform x:Name="DrawerShift" X="480"/></Border.RenderTransform>
                <v:DetailsDrawer DataContext="{Binding Details}"/>
            </Border>
        </Grid>

        <!-- ═════════════ toast ═════════════ -->
        <Border x:Name="ToastBox" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,44" Padding="16,10"
                CornerRadius="6" Background="#2C2C32" BorderBrush="{StaticResource LineHi}" BorderThickness="1"
                Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform><TranslateTransform x:Name="ToastShift" Y="12"/></Border.RenderTransform>
            <TextBlock Text="{Binding ToastText}" FontSize="13"/>
        </Border>
    </Grid>
</Window>
