<UserControl x:Class="OneFlowHub.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:OneFlowHub.Views"
             xmlns:vm="clr-namespace:OneFlowHub.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Grid Margin="0,0,6,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Panel}" Padding="3" CornerRadius="7">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Chip}" Content="ყველა" GroupName="flt" IsChecked="True"
                                 Command="{Binding FilterCommand}" CommandParameter="0"/>
                    <RadioButton Style="{StaticResource Chip}" Content="დაინსტალირებული" GroupName="flt"
                                 Command="{Binding FilterCommand}" CommandParameter="1"/>
                    <RadioButton Style="{StaticResource Chip}" Content="განახლებით" GroupName="flt"
                                 Command="{Binding FilterCommand}" CommandParameter="2"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="3" CornerRadius="7" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource ChipIcon}" Content="&#xE80A;" GroupName="vw" IsChecked="True" ToolTip="ბარათები"
                                 Command="{Binding ViewCommand}" CommandParameter="grid"/>
                    <RadioButton Style="{StaticResource ChipIcon}" Content="&#xE8FD;" GroupName="vw" ToolTip="სია"
                                 Command="{Binding ViewCommand}" CommandParameter="list"/>
                </StackPanel>
            </Border>
            <Button Grid.Column="3" Style="{StaticResource IconBtn}" Content="&#xE72C;" Command="{Binding RefreshCommand}" ToolTip="განახლება"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,6,24">

                <Border Visibility="{Binding NothingShown, Converter={StaticResource B2V}}" Style="{StaticResource Panel}" Padding="28">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="ვერაფერი მოიძებნა" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="სცადე სხვა სიტყვა ან შეცვალე ფილტრი." Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <Button Style="{StaticResource Ghost}" Content="ძებნის გასუფთავება" Margin="0,12,0,0" HorizontalAlignment="Center"
                                Command="{Binding ClearSearchCommand}"/>
                    </StackPanel>
                </Border>

                <!-- cards -->
                <ItemsControl ItemsSource="{Binding Library}" ItemTemplate="{StaticResource AppCard}"
                              Visibility="{Binding ViewGrid, Converter={StaticResource B2V}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- table -->
                <Border Style="{StaticResource Panel}" Visibility="{Binding ViewList, Converter={StaticResource B2V}}">
                    <StackPanel>
                        <Grid Margin="16,10,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="132"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="პროგრამა" Style="{StaticResource Overline}"/>
                            <TextBlock Grid.Column="2" Text="ვერსია" Style="{StaticResource Overline}"/>
                            <TextBlock Grid.Column="3" Text="სტატუსი" Style="{StaticResource Overline}"/>
                            <TextBlock Grid.Column="4" Text="ზომა" Style="{StaticResource Overline}"/>
                            <TextBlock Grid.Column="5" Text="გამოშვება" Style="{StaticResource Overline}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Library}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AppVM}">
                                    <Border Padding="16,10" Cursor="Hand" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#222226"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="2.2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="0.9*"/>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="132"/>
                                            </Grid.ColumnDefinitions>
                                            <v:AppIconTile Width="34" Height="34" HorizontalAlignment="Left"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding StageText}" Foreground="{Binding StageBrush}" FontSize="11.5"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding VersionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="{Binding BadgeForeground}" Margin="0,1,7,0"/>
                                                <TextBlock Text="{Binding BadgeText}" Foreground="{Binding BadgeForeground}" FontSize="12.5"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="4" Text="{Binding SizeText}" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                            <TextBlock Grid.Column="5" Text="{Binding UpdatedText}" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                            <Button Grid.Column="6" Style="{StaticResource Pill}" Content="{Binding PrimaryText}" Padding="10,6" FontSize="12.5"
                                                    Background="{Binding PrimaryBrush}" Foreground="{Binding PrimaryForeground}"
                                                    Command="{Binding PrimaryCommand}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
