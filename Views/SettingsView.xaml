<UserControl x:Class="OneFlowHub.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,6,28">

            <TextBlock Text="ზოგადი" Style="{StaticResource H2}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,26">
                <StackPanel>
                    <Border Style="{StaticResource Row}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Margin="0,0,60,0">
                                <TextBlock Text="დახურვა tray-ში" FontWeight="Medium"/>
                                <TextBlock Text="X-ზე დაჭერისას HUB არ გაითიშება და tray-ში დარჩება" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}" BorderThickness="0">
                        <Grid>
                            <StackPanel Margin="0,0,60,0">
                                <TextBlock Text="გაშვება Windows-თან ერთად" FontWeight="Medium"/>
                                <TextBlock Text="HUB ჩაირთვება კომპიუტერის ჩართვისას, ფანჯრის გარეშე" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="განახლებები" Style="{StaticResource H2}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,26">
                <StackPanel>
                    <Border Style="{StaticResource Row}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Margin="0,0,60,0">
                                <TextBlock Text="შემოწმება გაშვებისას" FontWeight="Medium"/>
                                <TextBlock Text="HUB-ისა და პროგრამების ახალი ვერსიები ავტომატურად მოიძებნება" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CheckOnStart, Mode=TwoWay}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}" BorderThickness="0">
                        <Grid>
                            <StackPanel Margin="0,0,140,0">
                                <TextBlock Text="1Flow HUB" FontWeight="Medium"/>
                                <TextBlock Text="{Binding HubVersion}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Style="{StaticResource Ghost}" Content="შემოწმება" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Padding="14,6" Command="{Binding CheckHubCommand}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="მონაცემები" Style="{StaticResource H2}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource Panel}">
                <Border Style="{StaticResource Row}" BorderThickness="0">
                    <Grid>
                        <StackPanel Margin="0,0,120,0">
                            <TextBlock Text="პროგრამების საქაღალდე" FontWeight="Medium"/>
                            <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Hint}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Style="{StaticResource Ghost}" Content="გახსნა" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Padding="14,6" Command="{Binding OpenDataFolderCommand}"/>
                    </Grid>
                </Border>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
