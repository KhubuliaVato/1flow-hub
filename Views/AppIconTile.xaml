<UserControl x:Class="OneFlowHub.Views.AppIconTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext = AppVM. Flat, neutral tile; size it with Width/Height. -->
    <Border x:Name="Frame" BorderThickness="1" ClipToBounds="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#2A2A2F"/>
                <Setter Property="BorderBrush" Value="#3A3A42"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasIcon}" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontWeight="SemiBold" Foreground="#D6D6DC"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding ShowGlyph, Converter={StaticResource B2V}}"/>
            <Image x:Name="Img" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="{Binding HasIcon, Converter={StaticResource B2V}}"/>
        </Grid>
    </Border>
</UserControl>
