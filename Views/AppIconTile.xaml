<UserControl x:Class="OneFlowHub.Views.AppIconTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext = AppVM. Size it with Width/Height; corner radius and glyph scale automatically. -->
    <Border x:Name="Frame" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{Binding AccentFrom}" Offset="0"/>
                <GradientStop Color="{Binding AccentTo}" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontWeight="SemiBold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding ShowGlyph, Converter={StaticResource B2V}}"/>
            <Image x:Name="Img" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="{Binding HasIcon, Converter={StaticResource B2V}}"/>
        </Grid>
    </Border>
</UserControl>
