<UserControl x:Class="OneFlowHub.Views.DetailsDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:OneFlowHub.Views"
             xmlns:vm="clr-namespace:OneFlowHub.ViewModels">
    <!-- DataContext = AppVM (MainVM.Details) -->
    <UserControl.Resources>
        <Style x:Key="Key" TargetType="TextBlock" BasedOn="{StaticResource Hint}"/>
        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Padding="22,18,16,16" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <v:AppIconTile Width="52" Height="52"/>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse Width="6" Height="6" Fill="{Binding BadgeForeground}" VerticalAlignment="Center" Margin="0,1,7,0"/>
                        <TextBlock Text="{Binding BadgeText}" FontSize="12.5" Foreground="{Binding BadgeForeground}"/>
                        <TextBlock Text="{Binding CategoryText}" Style="{StaticResource Hint}" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE8BB;" FontSize="11" VerticalAlignment="Top"
                        Click="OnClose"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,18,22,18">
                <TextBlock Text="{Binding Description}" FontSize="13" LineHeight="20" Foreground="#C9C9D1" TextWrapping="Wrap"/>

                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource B2V}}" Margin="0,16,0,0">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}"/>
                    <ProgressBar Style="{StaticResource Flow}" Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- facts -->
                <TextBlock Text="ინფორმაცია" Style="{StaticResource Overline}" Margin="0,22,0,8"/>
                <Border Style="{StaticResource Panel}" Padding="16,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="დაინსტალირებული ვერსია" Style="{StaticResource Key}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InstalledVersionText}" Style="{StaticResource Val}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Text="ბოლო ვერსია" Style="{StaticResource Key}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatestVersionText}" Style="{StaticResource Val}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Text="გამოშვების თარიღი" Style="{StaticResource Key}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UpdatedText}" Style="{StaticResource Val}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Text="ზომა" Style="{StaticResource Key}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource Val}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Text="დაინსტალირებულია" Style="{StaticResource Key}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding InstalledText}" Style="{StaticResource Val}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- changes -->
                <TextBlock Text="ცვლილებები" Style="{StaticResource Overline}" Margin="0,24,0,10"/>
                <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden" Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ReleaseTab}">
                                <Button Margin="0,0,6,0" Content="{Binding Tag}"
                                        Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                                            <Setter Property="Padding" Value="11,5"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="{Binding SelectedDate}" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding SelectedNotes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{Binding Text}" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"
                                           TextWrapping="Wrap" Visibility="{Binding IsHeading, Converter={StaticResource B2V}}"/>
                                <TextBlock Text="{Binding Text}" FontSize="12.5" LineHeight="19" Foreground="#C9C9D1" TextWrapping="Wrap"
                                           Visibility="{Binding IsText, Converter={StaticResource B2V}}"/>
                                <Grid Visibility="{Binding IsBullet, Converter={StaticResource B2V}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="4" Height="4" Fill="{StaticResource Dim}" Margin="0,8,10,0" VerticalAlignment="Top"/>
                                    <Border Grid.Column="1" Visibility="{Binding HasTag, Converter={StaticResource B2V}}"
                                            Margin="0,1,8,0" Padding="7,1" CornerRadius="4" Background="#2E2E34" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Tag}" FontSize="11"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="12.5" LineHeight="19" Foreground="#C9C9D1" TextWrapping="Wrap"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- actions -->
        <Border Grid.Row="2" Padding="22,14" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#161618">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource Pill}" Content="{Binding PrimaryText}" Padding="14,10"
                        Background="{Binding PrimaryBrush}" Foreground="{Binding PrimaryForeground}"
                        Command="{Binding PrimaryCommand}"/>
                <Button Grid.Column="1" Style="{StaticResource Ghost}" Content="საქაღალდე" Margin="8,0,0,0" Padding="14,10"
                        Command="{Binding LocateCommand}"/>
                <Button Grid.Column="2" Style="{StaticResource Ghost}" Content="{Binding RemoveText}" Margin="8,0,0,0" Padding="14,10"
                        Command="{Binding RemoveCommand}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
