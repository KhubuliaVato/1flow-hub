<UserControl x:Class="OneFlowHub.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:OneFlowHub.Views"
             xmlns:vm="clr-namespace:OneFlowHub.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,32">

            <!-- pending updates -->
            <Grid Margin="0,0,0,14">
                <TextBlock Text="ხელმისაწვდომი განახლებები" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource Pill}" Content="ყველას განახლება" HorizontalAlignment="Right" Padding="16,9" FontSize="13"
                        Background="#5CE6A0" Command="{Binding UpdateAllCommand}"
                        Visibility="{Binding HasUpdates, Converter={StaticResource B2V}}"/>
            </Grid>

            <Border Visibility="{Binding NoUpdates, Converter={StaticResource B2V}}" Padding="24,20" CornerRadius="22"
                    Background="#165CE6A0" BorderBrush="#445CE6A0" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="21" Background="#335CE6A0">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="#9BF2C6"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ყველაფერი განახლებულია" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="შენ გაქვს ყველა პროგრამის ბოლო ვერსია." Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Pending}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AppVM}">
                        <Border Margin="0,0,0,10" Padding="18,14" CornerRadius="18" Background="{StaticResource Surface}"
                                BorderBrush="#55FFC46B" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <v:AppIconTile Width="44" Height="44"/>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0">
                                        <Run Text="{Binding VersionText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding SizeText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource Ghost}" Content="ცვლილებები" Margin="0,0,10,0" Command="{Binding OpenCommand}"/>
                                <Button Grid.Column="3" Style="{StaticResource Pill}" Content="{Binding PrimaryText}" MinWidth="140"
                                        Background="{Binding PrimaryBrush}" Foreground="{Binding PrimaryForeground}" Command="{Binding PrimaryCommand}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- history -->
            <TextBlock Text="ისტორია" Style="{StaticResource H2}" Margin="0,30,0,14"/>

            <TextBlock Text="ისტორია ჯერ არ ჩანს. შეამოწმე ინტერნეტი და დააჭირე განახლებას." Style="{StaticResource Hint}" FontSize="14">
                <TextBlock.Visibility>
                    <Binding Path="HasFeed">
                        <Binding.Converter>
                            <!-- shown only when the feed is empty -->
                            <v:InvertBoolToVisibility/>
                        </Binding.Converter>
                    </Binding>
                </TextBlock.Visibility>
            </TextBlock>

            <ItemsControl ItemsSource="{Binding Feed}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FeedItem}">
                        <Border Margin="0,0,0,12" Padding="20,18" CornerRadius="20" Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}"/>
                            </Border.InputBindings>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SurfaceHi}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <v:AppIconTile Width="44" Height="44" VerticalAlignment="Top" DataContext="{Binding App}"/>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding AppName}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Margin="10,0,0,0" Padding="9,2" CornerRadius="9" Background="#26FFFFFF" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Tag}" FontSize="12"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DateText}" Style="{StaticResource Hint}" Margin="0,3,0,10"/>
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="5" Height="5" Fill="{StaticResource Accent}" Margin="0,8,10,0" VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13.5" LineHeight="20" Foreground="#DCDFF5"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
