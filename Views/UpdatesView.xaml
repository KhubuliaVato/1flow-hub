<UserControl x:Class="OneFlowHub.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:OneFlowHub.Views"
             xmlns:vm="clr-namespace:OneFlowHub.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,28">

            <!-- available -->
            <Grid Margin="0,0,0,12">
                <TextBlock Text="ხელმისაწვდომი" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource Pill}" Content="ყველას განახლება" HorizontalAlignment="Right" Padding="14,6"
                        Command="{Binding UpdateAllCommand}" Visibility="{Binding HasUpdates, Converter={StaticResource B2V}}"/>
            </Grid>

            <Border Visibility="{Binding NoUpdates, Converter={StaticResource B2V}}" Style="{StaticResource Panel}" Padding="18,14">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Ok}" Margin="0,0,10,0"/>
                    <TextBlock Text="ყველა პროგრამა განახლებულია" FontWeight="Medium"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}" Visibility="{Binding HasUpdates, Converter={StaticResource B2V}}">
                <ItemsControl ItemsSource="{Binding Pending}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AppVM}">
                            <Border Padding="16,12" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <v:AppIconTile Width="36" Height="36"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0">
                                            <Run Text="{Binding VersionText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding SizeText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource Ghost}" Content="ცვლილებები" Margin="0,0,8,0" Padding="12,6"
                                            Command="{Binding OpenCommand}"/>
                                    <Button Grid.Column="3" Style="{StaticResource Pill}" Content="{Binding PrimaryText}" MinWidth="118" Padding="12,6"
                                            Background="{Binding PrimaryBrush}" Foreground="{Binding PrimaryForeground}"
                                            Command="{Binding PrimaryCommand}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- history -->
            <TextBlock Text="ისტორია" Style="{StaticResource H2}" Margin="0,26,0,12"/>
            <TextBlock Text="ისტორია ჯერ არ ჩანს. შეამოწმე ინტერნეტი და განაახლე სია." Style="{StaticResource Hint}"
                       Visibility="{Binding HasFeed, Converter={StaticResource NotB2V}}"/>

            <ItemsControl ItemsSource="{Binding Feed}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FeedItem}">
                        <Border Margin="0,0,0,10" Padding="16,14" Cursor="Hand" CornerRadius="8" BorderThickness="1">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}"/>
                            </Border.InputBindings>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Surface}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource LineHi}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <v:AppIconTile Width="36" Height="36" VerticalAlignment="Top" DataContext="{Binding App}"/>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="4" Background="#2E2E34" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Tag}" FontSize="11.5"/>
                                        </Border>
                                        <TextBlock Text="{Binding DateText}" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Lines}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="4" Height="4" Fill="{StaticResource Dim}" Margin="0,8,9,0" VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12.5" LineHeight="19" Foreground="#C9C9D1"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
