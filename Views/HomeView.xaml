<UserControl x:Class="OneFlowHub.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:OneFlowHub.Views"
             xmlns:vm="clr-namespace:OneFlowHub.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,32">

            <!-- ═════ hero / featured ═════ -->
            <Grid Visibility="{Binding HasHero, Converter={StaticResource B2V}}">
                <Border DataContext="{Binding Hero}" CornerRadius="30" Height="272" ClipToBounds="True"
                        BorderBrush="#33FFFFFF" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{Binding AccentFrom}" Offset="0"/>
                            <GradientStop Color="{Binding AccentTo}" Offset="0.62"/>
                            <GradientStop Color="#FF0B0D28" Offset="1.15"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <!-- depth: dark wash + soft discs -->
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#99070816" Offset="0"/>
                                    <GradientStop Color="#33070816" Offset="0.7"/>
                                    <GradientStop Color="#00070816" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Ellipse Width="420" Height="420" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-110,-40" Fill="#14FFFFFF"/>
                        <Ellipse Width="260" Height="260" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-30,60,0" Fill="#12FFFFFF"/>

                        <v:AppIconTile Width="148" Height="148" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,70,0"/>

                        <StackPanel VerticalAlignment="Center" Margin="40,0,260,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border CornerRadius="10" Padding="11,4" Background="#33FFFFFF">
                                    <TextBlock Text="ბოლო განახლება" FontSize="11.5" FontWeight="SemiBold"/>
                                </Border>
                                <Border CornerRadius="10" Padding="10,4" Background="#26FFFFFF" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding LatestVersionText}" FontSize="11.5"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="38" FontWeight="Light" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding LatestSummary}" FontSize="14.5" LineHeight="22" Margin="0,8,0,22"
                                       Foreground="#E6E8FA" TextWrapping="Wrap" MaxHeight="46" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Pill}" Content="{Binding PrimaryText}" MinWidth="180"
                                        Background="{Binding PrimaryBrush}" Foreground="{Binding PrimaryForeground}"
                                        Command="{Binding PrimaryCommand}"/>
                                <Button Style="{StaticResource Ghost}" Content="დეტალები" Margin="10,0,0,0" Background="#26FFFFFF"
                                        Command="{Binding OpenCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═════ quick launch ═════ -->
            <Grid Margin="0,34,0,14">
                <TextBlock Text="სწრაფი გაშვება" Style="{StaticResource H2}"/>
                <TextBlock HorizontalAlignment="Right" Style="{StaticResource Hint}" VerticalAlignment="Bottom">
                    <Run Text="{Binding InstalledCount, Mode=OneWay}"/><Run Text=" დაინსტალირებული"/>
                </TextBlock>
            </Grid>

            <Border Visibility="{Binding NoInstalled, Converter={StaticResource B2V}}" Padding="24,22" CornerRadius="22"
                    BorderBrush="#33FFFFFF" BorderThickness="1" Background="#0CFFFFFF">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="ჯერ არაფერი გაქვს დაინსტალირებული" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="აირჩიე პროგრამა ბიბლიოთეკიდან — ინსტალაცია ერთი დაჭერით მთავრდება." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Style="{StaticResource Ghost}" Content="ბიბლიოთეკა →" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding DataContext.PageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="1"/>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Installed}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AppVM}">
                        <Border Width="268" Margin="0,0,14,14" Padding="16" CornerRadius="20" Cursor="Hand"
                                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}"/>
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <v:AppIconTile Width="46" Height="46"/>
                                <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE768;" Width="38" Height="38" FontSize="13"
                                        Background="{StaticResource Surface}" Command="{Binding PrimaryCommand}" ToolTip="{Binding PrimaryText}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═════ recent activity ═════ -->
            <Grid Margin="0,22,0,14">
                <TextBlock Text="ბოლო აქტივობა" Style="{StaticResource H2}"/>
                <Button Style="{StaticResource Ghost}" Content="ყველა →" HorizontalAlignment="Right" Padding="12,6" FontSize="12.5"
                        Command="{Binding DataContext.PageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="2"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding Recent}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FeedItem}">
                        <Border Margin="0,0,0,10" Padding="18,14" CornerRadius="18" Cursor="Hand"
                                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}"/>
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <v:AppIconTile Width="40" Height="40" DataContext="{Binding App}"/>
                                <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" FontSize="14"/>
                                        <Border Margin="9,0,0,0" Padding="8,1" CornerRadius="8" Background="#26FFFFFF" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Tag}" FontSize="11.5"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding DateText}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
