<UserControl x:Class="OneFlowHub.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:OneFlowHub.Views"
             xmlns:vm="clr-namespace:OneFlowHub.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,28">

            <!-- summary strip -->
            <UniformGrid Columns="3" Margin="0,0,-14,14">
                <Border Style="{StaticResource Panel}" Padding="18,14" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="პროგრამები" Style="{StaticResource Hint}"/>
                        <TextBlock Text="{Binding Apps.Count}" FontSize="26" FontWeight="Medium" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Padding="18,14" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="დაინსტალირებული" Style="{StaticResource Hint}"/>
                        <TextBlock Text="{Binding InstalledCount}" FontSize="26" FontWeight="Medium" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Padding="18,14" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="ხელმისაწვდომი განახლებები" Style="{StaticResource Hint}"/>
                        <TextBlock Text="{Binding UpdateCount}" FontSize="26" FontWeight="Medium" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUpdates}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- pending updates banner -->
            <Border Visibility="{Binding HasUpdates, Converter={StaticResource B2V}}" Style="{StaticResource Panel}"
                    BorderBrush="#66D9A441" Background="#1A1710" Padding="18,12" Margin="0,0,0,18">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Warn}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding SidebarUpdateText}" FontWeight="Medium"/>
                    </StackPanel>
                    <Button Style="{StaticResource Pill}" Content="ყველას განახლება" HorizontalAlignment="Right" Padding="14,6"
                            Command="{Binding UpdateAllCommand}"/>
                </Grid>
            </Border>

            <!-- installed -->
            <TextBlock Text="დაინსტალირებული" Style="{StaticResource H2}" Margin="0,6,0,12"/>

            <Border Visibility="{Binding NoInstalled, Converter={StaticResource B2V}}" Style="{StaticResource Panel}" Padding="20,18"
                    BorderBrush="{StaticResource LineHi}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="ჯერ არაფერი გაქვს დაინსტალირებული" FontWeight="SemiBold"/>
                        <TextBlock Text="აირჩიე პროგრამა სიიდან და დააჭირე „დაინსტალირება“." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Style="{StaticResource Ghost}" Content="აპლიკაციები" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding DataContext.PageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="1"/>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Installed}" ItemTemplate="{StaticResource AppCard}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- recent -->
            <Grid Margin="0,14,0,12">
                <TextBlock Text="ბოლო ცვლილებები" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource IconBtn}" Content="&#xE76C;" HorizontalAlignment="Right" Width="28" Height="28" FontSize="11"
                        Command="{Binding DataContext.PageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="2"
                        ToolTip="ყველა განახლება"/>
            </Grid>

            <Border Style="{StaticResource Panel}">
                <ItemsControl ItemsSource="{Binding Recent}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FeedItem}">
                            <Border Padding="16,12" Cursor="Hand" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}"/>
                                </Border.InputBindings>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#222226"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <v:AppIconTile Width="32" Height="32" DataContext="{Binding App}"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding AppName}" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding Tag}" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DateText}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
